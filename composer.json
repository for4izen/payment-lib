{
  "name": "elitehub/payment",
  "description": "Pacote modular para integração com múltiplos gateways de pagamento",
  "version": "1.0.0",
  "type": "library",
  "keywords": [
    "laravel",
    "elitehub",
    "payments",
    "gateway",
    "mercadopago",
    "pix",
    "checkout",
    "modular"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "For4izen",
      "email": "for4izen@elitehub.com",
      "homepage": "https://elitehub.tech",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/for4izen/payment-lib/tree/1.0.0",
  "support": {
    "issues": "https://github.com/for4izen/payment-lib/tree/1.0.0/issues",
    "source": "https://github.com/for4izen/payment-lib/tree/1.0.0"
  },
  "autoload": {
    "psr-4": {
      "EliteHub\\Payment\\": "src/"
    }
  },
  "require": {
    "php": "^8.4",
    "illuminate/support": "^10.0|^11.0|^12.0",
    "mercadopago/dx-php": "^3.0"
  },
  "extra": {
